{
  "name": "AR Hoops",
  "short_name": "AR Hoops",
  "description": "Place a basketball hoop on your real floor and swipe to shoot.",
  "id": "./",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait",
  "background_color": "#14110f",
